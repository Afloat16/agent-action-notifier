# EXAMPLE ONLY. This tool never loads .env files automatically.
# Supply real settings using your own protected environment or secret manager.
AAN_CHANNELS=stdout
# AAN_DB=/absolute/private/path/state.db
# AAN_ACTION_HOSTS=chatgpt.com,github.com
# AAN_INCLUDE_SUMMARY=1
# AAN_INCLUDE_ACTION=1
# Structured action text is email-only and opt-in; review it before enabling.
# AAN_SMTP_HOST=smtp.example.com
# AAN_SMTP_PORT=465
# AAN_SMTP_SECURITY=ssl
# AAN_SMTP_FROM=agent-notices@example.com
# AAN_SMTP_TO=owner@example.com
# AAN_SMTP_REPLY_TO=agent-replies@example.com
# Required for action emails with reply_prompt; one bare ASCII mailbox.
# Configure this mailbox yourself. No inbox polling or account setup is provided.
# Supply AAN_SMTP_USERNAME and AAN_SMTP_PASSWORD securely; do not commit them.
# For serve, supply an independently authorized AAN_WEBHOOK_TOKEN securely.
# No token is generated or installed by this project.
